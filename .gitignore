# Publish only the application and product planning documents.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/Start-Claude.ps1
!/Start-Claude.cmd
!/examples/
!/web/
!/기획/

# Local credentials, uploaded documents, databases and tool state never belong in Git.
**/.env*
!**/.env.example
**/.venture-pass/
**/node_modules/
**/.next/
**/.pnpm-store/
**/.codex/
**/.agents/
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.log
**/*.tsbuildinfo
**/CLAUDE.local.md
**/.claude/settings.local.json
examples/scheduling-simulation/dist/
